#!/bin/bash
# ordenargpu — crea copia ordenada sin modificar ~/set-fan-config
set -euo pipefail
CONFIG="${1:-$HOME/set-fan-config}"
[[ -f "$CONFIG" ]] || { echo "[error] No existe: $CONFIG"; exit 1; }
OUT="${2:-${CONFIG}.ordenada-$(date +%Y%m%d%H%M%S)}"
tmp="$(mktemp)"
trap 'rm -f "$tmp"' EXIT
awk '
BEGIN { split("max_temp min_speed max_speed critical_temp use_vram_temp use_hotspot_temp safety_all_sensors fan_update_interval_ms fan_change_threshold sensor_timeout_ms power_limit_mode power_limit auto_recover_gpu stop_on_gpu_lost", order); for (i=1;i<=length(order);i++) rank[order[i]]=i }
/^[[:space:]]*[A-Za-z_][A-Za-z0-9_]*=/ { key=$0; sub(/^[[:space:]]*/,"",key); sub(/=.*/,"",key); bucket=(key in rank ? rank[key] : 999); print sprintf("%03d\t%s", bucket, $0); next }
{ print "999\t" $0 }
' "$CONFIG" | sort -k1,1n -k2,2 | cut -f2- > "$tmp"
if cmp -s "$CONFIG" "$tmp"; then echo "[ok] Config ya está ordenada: $CONFIG"; exit 0; fi
cp -p "$tmp" "$OUT"
echo "[ok] Copia ordenada creada: $OUT"
echo "[info] Archivo original sin cambios: $CONFIG"
echo "[info] Validar antes de aplicar: set_fan_curve --check-config $OUT"

#!/bin/bash
# gpu-fan-diagnostic — diagnóstico pasivo; nunca cambia velocidad
set -u
command -v nvidia-smi >/dev/null 2>&1 || { echo "[error] nvidia-smi no está disponible"; exit 1; }
echo "Diagnóstico pasivo de ventiladores GPU"
echo "No se cambiarán velocidades."
echo
nvidia-smi --query-gpu=index,name,pci.bus_id --format=csv,noheader 2>/dev/null || true
for hw in /sys/class/hwmon/hwmon*; do
  [[ -r "$hw/name" ]] || continue
  name=$(cat "$hw/name")
  case "$name" in
    *nv*|*gpu*|*GPU*)
      echo "hwmon: $hw ($name)"
      for input in "$hw"/fan*_input; do
        [[ -r "$input" ]] || continue
        echo "  $(basename "$input"): $(cat "$input") RPM"
      done
      ;;
  esac
done
echo
echo "Nota: 0 % NVML no confirma 0 RPM. La clasificación es orientativa."
